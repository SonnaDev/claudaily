---
import { formatDate } from '../utils/content';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      date: Date;
      category: 'news' | 'tutorial';
      tags?: string[];
      difficulty?: 'Beginner' | 'Intermediate' | 'Advanced';
      estimatedTime?: string;
    };
  };
}

const { post } = Astro.props;
const { title, description, date, category, tags = [], difficulty, estimatedTime } = post.data;
const postHref = `/${category === 'news' ? 'news' : 'tutorials'}/${post.id}`;

const difficultyColors = {
  Beginner: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:text-emerald-300 border-emerald-300/40',
  Intermediate: 'bg-amber-100 text-amber-800 dark:bg-amber-950/70 dark:text-amber-300 border-amber-300/40',
  Advanced: 'bg-rose-100 text-rose-800 dark:bg-rose-950/70 dark:text-rose-300 border-rose-300/40',
};
---

<article class="group relative flex flex-col justify-between p-6 rounded-xl border border-border-light dark:border-border-dark bg-surface-light/60 dark:bg-surface-dark/60 hover:bg-surface-light dark:hover:bg-surface-dark transition-all duration-200 hover:border-accent/40 dark:hover:border-accent-dark/40 shadow-sm hover:shadow">
  <div>
    <!-- Badges & Date -->
    <div class="flex items-center flex-wrap gap-2 text-xs mb-3">
      <span class="inline-flex items-center px-2 py-0.5 rounded font-semibold uppercase tracking-wider text-[10px] bg-accent/10 text-accent dark:text-accent-dark">
        {category}
      </span>

      {difficulty && (
        <span class={`inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium border ${difficultyColors[difficulty]}`}>
          {difficulty}
        </span>
      )}

      {estimatedTime && (
        <span class="text-fg-mutedLight dark:text-fg-mutedDark text-[11px]">
          • {estimatedTime}
        </span>
      )}

      <time datetime={date.toISOString()} class="text-fg-mutedLight dark:text-fg-mutedDark ml-auto text-xs">
        {formatDate(date)}
      </time>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-serif font-bold text-fg-light dark:text-fg-dark group-hover:text-accent dark:group-hover:text-accent-dark transition-colors line-clamp-2">
      <a href={postHref} class="focus:outline-none focus:underline">
        <span class="absolute inset-0" aria-hidden="true"></span>
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p class="mt-2.5 text-sm text-fg-mutedLight dark:text-fg-mutedDark leading-relaxed line-clamp-3">
      {description}
    </p>
  </div>

  <!-- Tags Footer -->
  {tags.length > 0 && (
    <div class="mt-4 pt-4 border-t border-border-light/60 dark:border-border-dark/60 flex items-center gap-1.5 flex-wrap z-10">
      {tags.slice(0, 3).map((tag) => (
        <a
          href={`/tags/${tag.toLowerCase()}`}
          class="text-[11px] px-2 py-0.5 rounded bg-bg-light dark:bg-bg-dark text-fg-mutedLight dark:text-fg-mutedDark hover:text-accent hover:border-accent border border-border-light dark:border-border-dark transition-colors"
        >
          #{tag}
        </a>
      ))}
      {tags.length > 3 && (
        <span class="text-[11px] text-fg-mutedLight dark:text-fg-mutedDark">+{tags.length - 3}</span>
      )}
    </div>
  )}
</article>
