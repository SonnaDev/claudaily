---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

function getPageUrl(page: number) {
  if (page === 1) return baseUrl;
  return `${baseUrl.replace(/\/$/, '')}/page/${page}`;
}
---

{totalPages > 1 && (
  <nav aria-label="Pagination" class="flex items-center justify-center gap-3 mt-12 pt-8 border-t border-border-light dark:border-border-dark text-sm">
    {currentPage > 1 ? (
      <a
        href={getPageUrl(currentPage - 1)}
        class="px-4 py-2 rounded-lg border border-border-light dark:border-border-dark hover:bg-surface-light dark:hover:bg-surface-dark transition-colors"
      >
        ← Previous
      </a>
    ) : (
      <span class="px-4 py-2 rounded-lg border border-border-light/40 dark:border-border-dark/40 text-fg-mutedLight/40 dark:text-fg-mutedDark/40 cursor-not-allowed">
        ← Previous
      </span>
    )}

    <span class="text-xs text-fg-mutedLight dark:text-fg-mutedDark font-medium px-2">
      Page {currentPage} of {totalPages}
    </span>

    {currentPage < totalPages ? (
      <a
        href={getPageUrl(currentPage + 1)}
        class="px-4 py-2 rounded-lg border border-border-light dark:border-border-dark hover:bg-surface-light dark:hover:bg-surface-dark transition-colors"
      >
        Next →
      </a>
    ) : (
      <span class="px-4 py-2 rounded-lg border border-border-light/40 dark:border-border-dark/40 text-fg-mutedLight/40 dark:text-fg-mutedDark/40 cursor-not-allowed">
        Next →
      </span>
    )}
  </nav>
)}
