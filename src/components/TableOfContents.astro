---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length > 0 && (
  <nav aria-label="Table of contents" class="p-4 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark mb-8 text-sm">
    <h2 class="text-xs font-semibold tracking-wider uppercase text-fg-light dark:text-fg-dark mb-3">
      Table of Contents
    </h2>
    <ul class="space-y-1.5 text-xs sm:text-sm">
      {filteredHeadings.map((h) => (
        <li class={h.depth === 3 ? 'ml-4' : ''}>
          <a
            href={`#${h.slug}`}
            class="text-fg-mutedLight dark:text-fg-mutedDark hover:text-accent dark:hover:text-accent-dark transition-colors inline-block py-0.5"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
