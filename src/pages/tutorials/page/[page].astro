---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = (async () => {
  const POSTS_PER_PAGE = 6;
  const allTutorials = await getCollection('blog', ({ data }) => !data.draft && data.category === 'tutorial');
  const sortedTutorials = allTutorials.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  const totalPages = Math.ceil(sortedTutorials.length / POSTS_PER_PAGE);

  const paths = [];
  for (let i = 2; i <= totalPages; i++) {
    paths.push({
      params: { page: i.toString() },
      props: {
        posts: sortedTutorials.slice((i - 1) * POSTS_PER_PAGE, i * POSTS_PER_PAGE),
        currentPage: i,
        totalPages,
      },
    });
  }
  return paths;
}) satisfies GetStaticPaths;

const { posts, currentPage, totalPages } = Astro.props;
---

<BaseLayout
  title={`Tutorials - Page ${currentPage}`}
  description={`Browse Claude tutorials - page ${currentPage} of ${totalPages}`}
>
  <div class="mb-10 pb-6 border-b border-border-light dark:border-border-dark">
    <div class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold uppercase tracking-wider bg-accent/10 text-accent dark:text-accent-dark mb-3">
      Category
    </div>
    <h1 class="text-3xl sm:text-4xl font-serif font-black text-fg-light dark:text-fg-dark">
      Claude Tutorials (Page {currentPage})
    </h1>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </div>

  <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/tutorials" />
</BaseLayout>
