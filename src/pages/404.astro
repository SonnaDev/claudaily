---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wordmark from '../components/Wordmark.astro';
---

<BaseLayout
  title="404 - Page Not Found"
  description="The page you are looking for does not exist on Claudaily."
>
  <div class="py-20 text-center max-w-lg mx-auto">
    <span class="text-6xl font-serif font-black text-accent dark:text-accent-dark">404</span>
    <h1 class="text-3xl font-serif font-bold text-fg-light dark:text-fg-dark mt-4">
      Page Not Found
    </h1>
    <p class="mt-3 text-fg-mutedLight dark:text-fg-mutedDark text-base">
      We couldn't find the article or page you're searching for. It may have been moved, renamed, or never existed.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href="/"
        class="px-5 py-2.5 rounded-lg bg-fg-light dark:bg-fg-dark text-bg-light dark:text-bg-dark font-medium hover:opacity-90 transition-opacity text-sm"
      >
        Back to Home
      </a>
      <a
        href="/search"
        class="px-5 py-2.5 rounded-lg border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark font-medium hover:border-accent text-sm transition-colors"
      >
        Search Articles
      </a>
    </div>
  </div>
</BaseLayout>
